# ---------------------------------------------------------------------------
# PrepAgent backend environment variables (example file - no real secrets here)
# Copy to .env for local development. In production (Render) set these under
# Render -> Environment. Never commit the real .env file.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js.
# The database name goes between the host and the options, e.g. "/prepagent".
# If your password contains special characters ( : < > @ / ? # & % space ),
# percent-encode them here. For example:  p@ss<w>rd  ->  p%40ss%3Cw%3Erd
MONGODB_URI=mongodb+srv://<username>:<password-URL-encoded>@<cluster>.mongodb.net/prepagent?retryWrites=true&w=majority&appName=<appName>

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Frontend origin allowed by CORS (your Vercel URL in production).
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
